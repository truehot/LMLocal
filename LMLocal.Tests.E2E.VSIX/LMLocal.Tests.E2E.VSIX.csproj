<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>LMLocal.Tests.E2E.VSIX</RootNamespace>
    <VSTestHostRootSuffix>Exp</VSTestHostRootSuffix>
    <CopyVsixToTestDirectory>true</CopyVsixToTestDirectory>
    <IsTestProject>true</IsTestProject>
    <Platforms>AnyCPU;x64</Platforms>
    <SonarQubeTestProject>True</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LMLocal\LMLocal.csproj" Condition="Exists('..\LMLocal\LMLocal.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.1.0" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scratch files created by E2E RunTool tests must never compile into the test assembly. -->
    <Compile Remove="Scratch\**\*.cs" />
    <None Remove="Scratch\**" />
    <!-- Build benchmark fixture: a separate solution opened by the benchmark, never part of this assembly. -->
    <Compile Remove="Fixtures\BuildFixture\**" />
    <None Remove="Fixtures\BuildFixture\**" />
    <EmbeddedResource Remove="Fixtures\BuildFixture\**" />
    <!-- Reader benchmark fixtures: frozen C# text read by code_reader_subagent, never compiled.
         Kept as project items so find_files sees them (the SDK drops *.cs from None by default). -->
    <Compile Remove="Fixtures\ReaderCode\**" />
    <None Include="Fixtures\ReaderCode\**\*.cs" />
    <None Include="Fixtures\reader-ranges-fixture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures\reader-missing-files-fixture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures\reader-truth-fixture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures\reader-large-fixture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Fixtures\reader-symbols-fixture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>