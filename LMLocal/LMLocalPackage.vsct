<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--  This is the file that defines the actual layout and type of the commands.
        It is divided in different sections (e.g. command definition, command
        placement, ...), with each defining a specific set of properties.
        See the comment before each section for more details about how to
        use it. -->

  <!--  The VSCT compiler (the tool that translates this file into the binary
        format that VisualStudio will consume) has the ability to run a preprocessor
        on the vsct file; this preprocessor is (usually) the C++ preprocessor, so
        it is possible to define includes and macros with the same syntax used
        in C++ files. Using this ability of the compiler here, we include some files
        defining some of the constants that we will use inside the file. -->

  <!--This is the file that defines the IDs for all the commands exposed by VisualStudio. -->
  <Extern href="stdidcmd.h" />

  <!--This header contains the command ids for the menus provided by the shell. -->
  <Extern href="vsshlids.h" />


  <!--The Commands section is where commands, menus, and menu groups are defined.
      This section uses a Guid to identify the package that provides the command defined inside it. -->
  <Commands package="guidLMLocalPackage">
    <!-- Inside this section we have different sub-sections: one for the menus, another
    for the menu groups, one for the buttons (the actual commands), one for the combos
    and the last one for the bitmaps used. Each element is identified by a command id that
    is a unique pair of guid and numeric identifier; the guid part of the identifier is usually
    called "command set" and is used to group different command inside a logically related
    group; your package should define its own command set in order to avoid collisions
    with command ids defined by other packages. -->

    <!-- Menus section: defines submenus used in context menus -->
    <Menus>
      <!-- Submenu "LM Local Commands" inside the code editor context menu -->
      <Menu guid="guidLMLocalPackageCmdSet" id="LMLocalSubMenu" priority="0x0011" type="Menu">
        <Parent guid="guidLMLocalPackageCmdSet" id="EditorContextGroup" />
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <Strings>
          <ButtonText>LM Local Commands</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <!-- In this section you can define new menu groups. A menu group is a container for
         other menus or buttons (commands); from a visual point of view you can see the
         group as the part of a menu contained between two lines. The parent of a group
         must be a menu. -->
    <Groups>
      <Group guid="guidLMLocalPackageCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <!-- Context menu group inside the code editor context menu (IDM_VS_CTXT_CODEWIN) -->
      <Group guid="guidLMLocalPackageCmdSet" id="EditorContextGroup" priority="0x0010">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
      <!-- Group inside the "LM Local Commands" submenu to hold all code commands -->
      <Group guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" priority="0x0010">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalSubMenu" />
      </Group>

      <!-- Solution Explorer context menu groups -->
      <Group guid="guidLMLocalPackageCmdSet" id="SolutionExplorerItemGroup" priority="0x0010">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE"/>
      </Group>
      <Group guid="guidLMLocalPackageCmdSet" id="SolutionExplorerFolderGroup" priority="0x0010">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_FOLDERNODE"/>
      </Group>
      <Group guid="guidLMLocalPackageCmdSet" id="SolutionExplorerProjectGroup" priority="0x0010">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE"/>
      </Group>
      <Group guid="guidLMLocalPackageCmdSet" id="SolutionExplorerSolutionGroup" priority="0x0010">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE"/>
      </Group>
    </Groups>

    <!--Buttons section. -->
    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <!--To define a menu group you have to specify its ID, the parent menu and its display priority.
          The command is visible and enabled by default. If you need to change the visibility, status, etc, you can use
          the CommandFlag node.
          You can add more than one CommandFlag node e.g.:
              <CommandFlag>DefaultInvisible</CommandFlag>
              <CommandFlag>DynamicVisibility</CommandFlag>
          If you do not want an image next to your command, remove the Icon node /> -->
      <Button guid="guidLMLocalPackageCmdSet" id="ShowMainWindowId" priority="0x0100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="MyMenuGroup" />
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <Strings>
          <ButtonText>LM Local Chat</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidMainWindowCommand" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <Strings>
          <ButtonText>LM Local Chat</ButtonText>
        </Strings>
      </Button>

      <!-- Context menu button "Send to LM Local" for the code editor -->
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidAskLMLocal" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="EditorContextGroup" />
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Send to LM Local</ButtonText>
        </Strings>
      </Button>

      <!-- All code-specific commands inside the "LM Local Commands" submenu -->
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidReviewCode" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Review Code</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidBugFixCode" priority="0x110" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>BugFix Code</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidAddUnitTests" priority="0x120" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Add Unit Tests</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidAddSummary" priority="0x130" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Add Summary</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidImproveCode" priority="0x150" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Improve Code</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidExplainCode" priority="0x160" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="LMLocalCommandsGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Explain Code</ButtonText>
        </Strings>
      </Button>

      <!-- Solution Explorer context menu buttons "Send to LM Local" -->
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidSendToLMFromSE_Item" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="SolutionExplorerItemGroup"/>
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Send File to LM Local</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidSendToLMFromSE_Folder" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="SolutionExplorerFolderGroup"/>
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Send Folder to LM Local</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidSendToLMFromSE_Project" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="SolutionExplorerProjectGroup"/>
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Send Project to LM Local</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidLMLocalPackageCmdSet" id="cmdidSendToLMFromSE_Solution" priority="0x100" type="Button">
        <Parent guid="guidLMLocalPackageCmdSet" id="SolutionExplorerSolutionGroup"/>
        <Icon guid="guidMyIconSet" id="iconLMLocal" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Send Solution to LM Local</ButtonText>
        </Strings>
      </Button>

    </Buttons>

    <!--The bitmaps section is used to define the bitmaps that are used for the commands.-->
    <Bitmaps>
      <Bitmap guid="guidMyIconSet" href="Resources\\icon.ico" usedList="iconLMLocal"/>
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidMyIconSet" value="{dc60de45-6b26-4b00-b969-92c6dd30dc08}">
      <IDSymbol name="iconLMLocal" value="1" />
    </GuidSymbol>


    <!-- This is the package guid. -->
    <GuidSymbol name="guidLMLocalPackage" value="{d2b7ae34-5422-4af0-bfc3-6129fd2641d0}" />

    <!-- This is the guid used to group the menu commands together -->
    <GuidSymbol name="guidLMLocalPackageCmdSet" value="{c29700c4-7786-468f-bf99-0ecb9d69343f}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="ShowMainWindowId" value="0x0100" />
      <IDSymbol value="4129" name="cmdidMainWindowCommand" />
      <IDSymbol name="EditorContextGroup" value="0x1030" />
      <IDSymbol name="LMLocalSubMenu" value="0x2000" />
      <IDSymbol name="LMLocalCommandsGroup" value="0x1040" />
      <IDSymbol name="cmdidAskLMLocal" value="0x0200" />
      <IDSymbol name="cmdidReviewCode" value="0x0201" />
      <IDSymbol name="cmdidBugFixCode" value="0x0202" />
      <IDSymbol name="cmdidAddUnitTests" value="0x0203" />
      <IDSymbol name="cmdidAddSummary" value="0x0204" />
      <IDSymbol name="cmdidImproveCode" value="0x0206" />
      <IDSymbol name="cmdidExplainCode" value="0x0207" />

      <!-- Solution Explorer group IDs -->
      <IDSymbol name="SolutionExplorerItemGroup" value="0x1050" />
      <IDSymbol name="SolutionExplorerFolderGroup" value="0x1051" />
      <IDSymbol name="SolutionExplorerProjectGroup" value="0x1052" />
      <IDSymbol name="SolutionExplorerSolutionGroup" value="0x1053" />

      <!-- Solution Explorer command IDs -->
      <IDSymbol name="cmdidSendToLMFromSE_Item" value="0x0208" />
      <IDSymbol name="cmdidSendToLMFromSE_Folder" value="0x0209" />
      <IDSymbol name="cmdidSendToLMFromSE_Project" value="0x020A" />
      <IDSymbol name="cmdidSendToLMFromSE_Solution" value="0x020B" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
