<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="LMLocal.aa226645-3f53-489b-befb-2d37a76e7590" Version="1.9.1" Language="en-US" Publisher="Aleksandrs Kornevs" />
        <DisplayName>LM Local</DisplayName>
        <Description xml:space="preserve">Lightweight, secure local AI chat window for Visual Studio 2022/2026. Stream responses from LM Studio, Ollama, and Jan with full code context, expandable reasoning thoughts, customized system roles, smart token caching, and extendable modern HTTP MCP toolkits.</Description>
        <License>LICENSE.txt</License>
        <GettingStartedGuide>GettingStarted.txt</GettingStartedGuide>
        <Icon>Resources\logo.png</Icon>
        <Tags>LM Studio, LLM, Local AI, Chat, Ollama, Jan, MCP</Tags>
    </Metadata>
    <Installation>
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Dependencies>
        <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
    </Dependencies>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
